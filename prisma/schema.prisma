// Prisma schema for COREY's server-side persistence (Postgres).
// Model bytes live in MinIO (S3); this database holds model metadata and the
// validation rules configuration and data-table drafts. See
// docker/docker-compose.deploy.yml for local services.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Metadata for an uploaded IFC model. The bytes of each version are stored in
/// object storage (see ModelVersionRecord.objectKey); this row is the stable
/// record downstream persistence (rules results, drafts) keys off via `id`.
/// `ownerId` is the user (from the reverse-proxy identity header) the model is
/// private to. `size` tracks the latest version's size.
model ModelRecord {
  id                String                   @id @default(uuid())
  ownerId           String
  name              String
  size              Int
  uploadedAt        DateTime                 @default(now())
  draft             DraftRecord?
  versions          ModelVersionRecord[]

  @@index([ownerId, uploadedAt])
  @@map("model_records")
}

/// One row per stored version of a model. `objectKey` is stored explicitly so
/// legacy single-file models (key `${modelId}.ifc`) and new versions
/// (`${modelId}/v${n}.ifc`) coexist without conditional key logic on read and
/// delete paths. Versions are immutable once written. `changeSummary` holds a
/// `ModelVersionChangeSummary` (structural diff counts vs the previous latest
/// version, computed at upload time); null for initial/legacy versions.
model ModelVersionRecord {
  id            String      @id @default(uuid())
  modelId       String
  versionNumber Int
  size          Int
  objectKey     String
  label         String?
  changeSummary Json?
  uploadedAt    DateTime    @default(now())
  model         ModelRecord @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, versionNumber])
  @@map("model_version_records")
}

/// The validation rules configuration. One document per user — the `id` holds
/// the user id (from the reverse-proxy identity header). Stored as JSON so the
/// `ViewerValidationConfig` shape can evolve without migrations.
model RuleConfig {
  id        String   @id
  config    Json
  updatedAt DateTime @updatedAt

  @@map("rule_configs")
}

/// Server-managed validation template catalog. Built-in starter templates are
/// seeded from the existing resource files, then served through API routes so
/// clients no longer fetch validation catalogs directly from public assets.
model RuleTemplateRecord {
  id             String   @id
  name           String
  description    String
  sourceKind     String   @default("starter")
  sourceFileName String?
  sourceText     String?
  config         Json
  ruleCount      Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder, name])
  @@map("rule_template_records")
}

/// Imported data-table edits for a server-backed IFC model. One draft per
/// model today; the row is keyed by the stable model id so local cache entries
/// can be promoted to durable server state.
model DraftRecord {
  modelId   String      @id
  draft     Json
  updatedAt DateTime    @updatedAt
  model     ModelRecord @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("draft_records")
}

/// Deployment-wide MCP access state. The singleton row uses id "deployment".
/// API key material is never stored in plaintext.
model McpDeploymentConfig {
  id              String   @id
  enabled         Boolean  @default(false)
  apiKeyHash      String?  @unique
  apiKeyHint      String?
  apiKeyRotatedAt DateTime?
  updatedAt       DateTime @updatedAt

  @@map("mcp_deployment_configs")
}

/// Dynamically registered public OAuth clients for hosted MCP consumers.
model McpOAuthClient {
  id             String                  @id
  metadata       Json
  createdAt      DateTime                @default(now())
  authorizations McpOAuthAuthorization[]
  tokens         McpOAuthToken[]

  @@map("mcp_oauth_clients")
}

/// Short-lived OAuth consent requests and one-time authorization codes.
model McpOAuthAuthorization {
  id            String         @id @default(uuid())
  clientId      String
  redirectUri   String
  state         String?
  scopes        Json
  codeChallenge String
  resource      String?
  codeHash      String?        @unique
  approvedAt    DateTime?
  consumedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  client        McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@map("mcp_oauth_authorizations")
}

/// OAuth access and rotating refresh credentials. Both token values are hashed.
model McpOAuthToken {
  id               String         @id @default(uuid())
  clientId         String
  accessTokenHash  String         @unique
  refreshTokenHash String         @unique
  scopes           Json
  resource         String?
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  revokedAt        DateTime?
  createdAt        DateTime       @default(now())
  client           McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, refreshExpiresAt])
  @@map("mcp_oauth_tokens")
}

/// An immutable build of the deployment-wide knowledge corpus. A completed
/// revision is activated only after every chunk has an embedding.
model KnowledgeCorpusRevision {
  id                  String              @id
  sourceFingerprint   String              @unique
  status              String
  embeddingModel      String
  embeddingDimensions Int
  manifest            Json
  createdAt           DateTime            @default(now())
  activatedAt         DateTime?
  documents           KnowledgeDocument[]
  chunks              KnowledgeChunk[]
  evidences           KnowledgeEvidence[]
  nodes               KnowledgeNode[]
  edges               KnowledgeEdge[]
  ingestRuns           KnowledgeIngestRun[]

  @@index([status, activatedAt])
  @@map("knowledge_corpus_revisions")
}

model KnowledgeDocument {
  id         String                  @id
  revisionId String
  sourceKey  String
  sourceKind String
  title      String
  fileName   String
  sha256     String
  edition    String?
  metadata   Json
  revision   KnowledgeCorpusRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  chunks     KnowledgeChunk[]
  evidences  KnowledgeEvidence[]

  @@unique([revisionId, sourceKey])
  @@index([revisionId, sourceKind])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String                  @id
  revisionId     String
  documentId     String
  stableKey      String
  contentHash    String
  content        String
  sourceKind     String
  sourceRole     String
  locator        String
  pageNumber     Int?
  sheetName      String?
  rowStart       Int?
  rowEnd         Int?
  tokenCount     Int
  metadata       Json
  embeddingModel String
  embedding      Unsupported("vector(1536)")?
  searchVector   Unsupported("tsvector")? @map("search_vector")
  revision       KnowledgeCorpusRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  evidenceLinks  KnowledgeChunkEvidence[]

  @@unique([revisionId, stableKey])
  @@index([revisionId, sourceKind, sourceRole])
  @@index([documentId, pageNumber])
  @@index([documentId, sheetName, rowStart])
  @@map("knowledge_chunks")
}

/// An immutable, source-local passage used to explain exactly where a
/// retrieved chunk came from. PDF locators include page geometry; workbook
/// locators retain their sheet and row provenance.
model KnowledgeEvidence {
  id             String                   @id
  revisionId     String
  documentId     String
  ordinal        Int
  sectionPath    String[]                 @default([])
  locator        Json
  rawText        String
  normalizedText String
  contentHash    String
  metadata       Json
  revision       KnowledgeCorpusRevision  @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkLinks     KnowledgeChunkEvidence[]

  @@unique([documentId, ordinal])
  @@index([revisionId, documentId, ordinal])
  @@index([contentHash])
  @@map("knowledge_evidence")
}

model KnowledgeChunkEvidence {
  chunkId    String
  evidenceId String
  chunk      KnowledgeChunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  evidence   KnowledgeEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([chunkId, evidenceId])
  @@index([evidenceId])
  @@map("knowledge_chunk_evidence")
}

model KnowledgeNode {
  id           String                  @id
  revisionId   String
  canonicalKey String
  nodeType     String
  label        String
  properties   Json
  revision     KnowledgeCorpusRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, canonicalKey])
  @@index([revisionId, nodeType, label])
  @@map("knowledge_nodes")
}

model KnowledgeEdge {
  id              String                  @id
  revisionId      String
  fromNodeId      String
  toNodeId        String
  relationType    String
  evidenceChunkId String?
  assertionKind   String
  properties      Json
  revision        KnowledgeCorpusRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, fromNodeId, toNodeId, relationType, assertionKind])
  @@index([revisionId, fromNodeId])
  @@index([revisionId, toNodeId])
  @@index([evidenceChunkId])
  @@map("knowledge_edges")
}

model KnowledgeIngestRun {
  id            String                  @id @default(uuid())
  revisionId    String
  status        String
  embeddedCount Int                     @default(0)
  failedCount   Int                     @default(0)
  error         String?
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  revision      KnowledgeCorpusRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId, startedAt])
  @@map("knowledge_ingest_runs")
}
