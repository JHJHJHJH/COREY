# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local IFC fixtures. Public sample models must have explicit provenance before
# being committed; see public/resources/README.md.
/public/resources/*.ifc

#videos
/playwright-artifacts/*

# server model store (local filesystem backend)
/.data
/src/generated/prisma

# local env (use .env.example as the template)
/.env
.pnpm-store/
