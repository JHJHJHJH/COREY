{
  "name": "corey",
  "description": "Local-first IFC review app with an optional self-hosted backend.",
  "version": "1.2.4",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JHJHJHJH/Corey.git"
  },
  "bugs": {
    "url": "https://github.com/JHJHJHJH/Corey/issues"
  },
  "homepage": "https://github.com/JHJHJHJH/Corey#readme",
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@hono/node-server": "2.0.10",
      "@prisma/config>deepmerge-ts": "8.0.0",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^2": "2.1.7",
      "brace-expansion@^5": "5.0.8",
      "browserslist": "4.28.7",
      "esbuild": "0.28.1",
      "fast-uri": "3.1.8",
      "hono": "4.13.7",
      "ip-address": "10.7.1",
      "js-yaml": "4.3.1",
      "mysql2": "3.23.1",
      "postcss": "8.5.26",
      "qs": "6.16.0",
      "proxy-addr": "2.0.8",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "baseline-browser-mapping": "2.11.0",
      "uuid": "11.1.1",
      "valibot": "1.4.2"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-14257"
      ]
    }
  },
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "fumadocs-mdx && pnpm mcp:build && next build --webpack",
    "start": "next start -p 4000",
    "lint": "eslint",
    "docs:generate": "fumadocs-mdx",
    "check:assets": "node scripts/check-runtime-assets.mjs",
    "templates:generate": "tsx scripts/generate-industry-templates.ts",
    "templates:check": "tsx --test src/features/rules/lib/industry-mapping-generator.test.ts",
    "mcp:build": "tsup",
    "mcp:http": "tsx src/mcp/cli.ts",
    "mcp:test": "tsx --test src/features/viewer/mcp/*.test.ts src/features/rules/lib/*.test.ts src/server/*.test.ts src/mcp/*.test.ts",
    "viewer:test": "tsx --test src/features/viewer/lib/*.test.ts",
    "audit:prod": "pnpm audit --prod",
    "verify": "pnpm docs:generate && pnpm mcp:test && pnpm viewer:test && pnpm lint && pnpm check:assets && pnpm build && pnpm audit:prod",
    "postinstall": "prisma generate && fumadocs-mdx",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@thatopen/components": "^3.4.8",
    "@thatopen/components-front": "^3.4.4",
    "@thatopen/fragments": "^3.4.7",
    "camera-controls": "3.1.2",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "fumadocs-core": "16.16.0",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "1.29.2",
    "three": "^0.186.1",
    "web-ifc": "^0.0.78",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "5.0.6",
    "@types/mdx": "2.0.14",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@types/ws": "8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vite": "8.2.0"
  }
}
