# Docker Compose defaults. Copy this file to .env before running the compose
# stacks, then adjust values for your environment.

POSTGRES_USER=corey
POSTGRES_PASSWORD=corey
POSTGRES_DB=corey
POSTGRES_PORT=5433

S3_REGION=ap-southeast-1
S3_ACCESS_KEY=corey
S3_SECRET_KEY=corey-secret
S3_BUCKET=corey-models
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

COREY_MAX_MODEL_BYTES=262144000
PORT=4000

# OpenAI-backed knowledge retrieval. The key is consumed only by server routes
# and the knowledge ingestion command; never prefix it with NEXT_PUBLIC_.
# OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Optional MCP companion. The bridge stays disabled in COREY unless both the
# public WebSocket URL and a shared secret (32+ characters) are configured.
# COREY_MCP_BRIDGE_URL=ws://localhost:4001/bridge
# COREY_MCP_BRIDGE_SECRET=ZHEBK79QN79DZRY8WKRQWTS5YXWQJJQ3
# COREY_MCP_ALLOWED_ORIGINS=http://localhost:4000
# COREY_MCP_PUBLIC_URL=http://localhost:4001/mcp
# COREY_APP_PUBLIC_URL=http://localhost:4000
# COREY_MCP_INTERNAL_URL=http://localhost:4001
# COREY_MCP_ADMIN_USERS=local
# COREY_MCP_PORT=4001
# COREY_MCP_INDEX_CACHE_ENTRIES=3
# COREY_MCP_TRUST_PROXY=1
# COREY_BASE_URL=http://localhost:4000

# Optional: point the app container at external services instead of the compose
# services.
# DOCKER_DATABASE_URL=postgresql://corey:corey@postgres:5432/corey?schema=public
# DOCKER_S3_ENDPOINT=http://minio:9000

# Optional: for pnpm dev on the host while using compose services.
# DATABASE_URL=postgresql://corey:corey@localhost:5433/corey?schema=public
# S3_ENDPOINT=http://localhost:9002
