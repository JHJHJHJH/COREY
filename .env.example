# Docker Compose defaults. Copy this file to .env before running the compose
# stacks, then adjust values for your environment.

POSTGRES_USER=corey
POSTGRES_PASSWORD=corey
POSTGRES_DB=corey
POSTGRES_PORT=5433

S3_REGION=ap-southeast-1
S3_ACCESS_KEY=corey
S3_SECRET_KEY=corey-secret
S3_BUCKET=corey-models
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

COREY_MAX_MODEL_BYTES=262144000
PORT=4000

# Optional MCP stdio companion. Generate one shared secret with:
# openssl rand -hex 32
# Set both values to enable the per-tab MCP connection control in COREY.
COREY_MCP_BRIDGE_URL=ws://localhost:4001/bridge
COREY_MCP_BRIDGE_SECRET=
# The remaining values configure the companion container.
COREY_BASE_URL=http://host.docker.internal:4000
COREY_MCP_ALLOWED_ORIGINS=http://localhost:4000
COREY_MCP_BIND=0.0.0.0
COREY_MCP_PORT=4001
COREY_MCP_INDEX_CACHE_ENTRIES=3
COREY_USER_ID=local
COREY_USER_HEADER=x-forwarded-user

# Optional: point the app container at external services instead of the compose
# services.
# DOCKER_DATABASE_URL=postgresql://corey:corey@postgres:5432/corey?schema=public
# DOCKER_S3_ENDPOINT=http://minio:9000

# Optional: for pnpm dev on the host while using compose services.
# DATABASE_URL=postgresql://corey:corey@localhost:5433/corey?schema=public
# S3_ENDPOINT=http://localhost:9002
